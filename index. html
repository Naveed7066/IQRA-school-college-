<body>&lt;!DOCTYPE html&gt;<br/>&lt;html lang=&quot;ur&quot;&gt;<br/>&lt;head&gt;<br/>&lt;meta charset=&quot;UTF-8&quot;&gt;<br/>&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;<br/>&lt;title&gt;IQRA PUBLIC HIGH SCHOOL - QR Attendance&lt;/title&gt;<br/>&lt;script src=&quot;https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js&quot;&gt;&lt;/script&gt;<br/>&lt;script src=&quot;https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js&quot;&gt;&lt;/script&gt;<br/>&lt;script src=&quot;https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js&quot;&gt;&lt;/script&gt;<br/>&lt;script src=&quot;https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js&quot;&gt;&lt;/script&gt;<br/>&lt;style&gt;<br/>*{box-sizing:border-box;font-family:Arial} body{margin:0;background:#eef2ff;padding:10px}<br/>.header{background:#0a1a4d;color:#fff;border-radius:16px;padding:14px;text-align:center;border:3px solid #d4af37}<br/>.header img{width:95px;height:95px;object-fit:contain;background:#fff;border-radius:50%;border:3px solid #d4af37}<br/>.header h1{margin:6px 0 0;font-size:22px}.header p{margin:2px;color:#fde68a;font-weight:bold}<br/>.tabs{display:flex;gap:5px;margin:10px 0;flex-wrap:wrap}<br/>.tabs button{flex:1;padding:11px;border:0;border-radius:10px;background:#fff;font-weight:bold;cursor:pointer;min-width:100px}<br/>.tabs button.active{background:#0a1a4d;color:#fff}<br/>.card{background:#fff;padding:15px;border-radius:14px;margin-bottom:12px;box-shadow:0 2px 8px #0001}<br/>input,select{width:100%;padding:11px;margin:6px 0;border:1px solid #cbd5e1;border-radius:8px}<br/>.btn{width:100%;padding:13px;border:0;border-radius:10px;background:#16a34a;color:#fff;font-weight:bold;font-size:16px;margin-top:8px}<br/>.btn-blue{background:#2563eb}.btn-red{background:#dc2626}.btn-orange{background:#ea580c}.btn-dark{background:#0a1a4d}.btn-purple{background:#7c3aed}<br/>.bulk{background:#fef9c3;border:2px dashed #eab308;padding:14px;border-radius:12px;margin-top:12px}<br/>.student{display:flex;gap:10px;align-items:center}<br/>.student img{width:55px;height:55px;object-fit:cover;border-radius:50%;background:#ddd}<br/>.present{border:2px solid #16a34a}.absent{border:2px solid #fca5a5}<br/>#reader{width:100%;border-radius:12px;overflow:hidden}<br/>.qr-card{width:330px;margin:10px auto;background:#fff;border:3px solid #0a1a4d;border-radius:16px;padding:12px;text-align:center}<br/>.qr-card .logo{width:70px;height:70px;object-fit:contain}<br/>.qr-card .stu{width:105px;height:105px;object-fit:cover;border-radius:50%;border:3px solid #0a1a4d}<br/>.qr-card h2{margin:5px 0 0;color:#0a1a4d}.qr-card p{margin:2px}<br/>table{width:100%;border-collapse:collapse;font-size:13px} th,td{border:1px solid #ddd;padding:7px;text-align:center} th{background:#0a1a4d;color:#fff}<br/>@media print{body *{visibility:hidden}.qr-card,.qr-card *{visibility:visible}.qr-card{position:absolute;top:0;left:0}}<br/>&lt;/style&gt;<br/>&lt;/head&gt;<br/>&lt;body&gt;<br/>&lt;div class=&quot;header&quot;&gt;<br/>&lt;img src=&quot;logo.jpg&quot; onerror=&quot;this.src=&#39;https://via.placeholder.com/95?text=IPS&#39;&quot;&gt;<br/>&lt;h1&gt;IQRA PUBLIC HIGH SCHOOL&lt;/h1&gt;&lt;p&gt;YASIR TOWN FSD | Knowledge is Light&lt;/p&gt;<br/>&lt;p style=&quot;color:#fff;font-size:13px&quot;&gt;📚 QR Attendance System&lt;/p&gt;<br/>&lt;/div&gt;<br/>&lt;div class=&quot;tabs&quot;&gt;<br/>&lt;button id=&quot;t1&quot; class=&quot;active&quot; onclick=&quot;show(1)&quot;&gt;➕ Add Student&lt;/button&gt;<br/>&lt;button id=&quot;t2&quot; onclick=&quot;show(2)&quot;&gt;📷 Scan&lt;/button&gt;<br/>&lt;button id=&quot;t3&quot; onclick=&quot;show(3)&quot;&gt;👥 All Students&lt;/button&gt;<br/>&lt;button id=&quot;t4&quot; onclick=&quot;show(4)&quot;&gt;📋 Absent + WhatsApp&lt;/button&gt;<br/>&lt;button id=&quot;t5&quot; onclick=&quot;show(5)&quot;&gt;📊 Monthly Report&lt;/button&gt;<br/>&lt;/div&gt;<br/><br/>&lt;div id=&quot;p1&quot; class=&quot;card&quot;&gt;<br/>&lt;h3&gt;Naya Student Add Karein - Single&lt;/h3&gt;<br/>&lt;input id=&quot;sName&quot; placeholder=&quot;Student Name&quot;&gt;<br/>&lt;input id=&quot;sClass&quot; placeholder=&quot;Class - e.g 5th&quot;&gt;<br/>&lt;input id=&quot;sRoll&quot; placeholder=&quot;Roll No&quot;&gt;<br/>&lt;input id=&quot;sPhone&quot; placeholder=&quot;Parent WhatsApp No - 0321...&quot;&gt;<br/>&lt;label&gt;Student Picture&lt;/label&gt;<br/>&lt;input type=&quot;file&quot; id=&quot;sPhoto&quot; accept=&quot;image/*&quot;&gt;<br/>&lt;button class=&quot;btn btn-blue&quot; onclick=&quot;addStudent()&quot;&gt;Save + QR Card Banao&lt;/button&gt;<br/><br/>&lt;div class=&quot;bulk&quot;&gt;<br/>&lt;h3&gt;📂 BULK UPLOAD - Ek Sath Sare Students&lt;/h3&gt;<br/>&lt;p style=&quot;font-size:13px&quot;&gt;Excel (.xlsx) / CSV / PDF file upload karein. Format: &lt;b&gt;Name | Class | Roll | Parent Phone&lt;/b&gt;&lt;br&gt;Pehli line heading ho.&lt;/p&gt;<br/>&lt;input type=&quot;file&quot; id=&quot;bulkFile&quot; accept=&quot;.xlsx,.xls,.csv,.pdf&quot;&gt;<br/>&lt;button class=&quot;btn btn-purple&quot; onclick=&quot;handleBulk()&quot;&gt;📥 File Upload Karke Sare Students Add Karein&lt;/button&gt;<br/>&lt;button class=&quot;btn btn-dark&quot; onclick=&quot;downloadSample()&quot;&gt;⬇️ Sample Excel Format Download Karein&lt;/button&gt;<br/>&lt;div id=&quot;bulkPreview&quot; style=&quot;margin-top:10px;font-size:13px&quot;&gt;&lt;/div&gt;<br/>&lt;/div&gt;<br/>&lt;div id=&quot;newCard&quot;&gt;&lt;/div&gt;<br/>&lt;button class=&quot;btn btn-orange&quot; onclick=&quot;printAllQRCards()&quot;&gt;🖨️ Sare Students ke QR Cards Ek Sath Print Karein&lt;/button&gt;<br/>&lt;div id=&quot;allQRCards&quot;&gt;&lt;/div&gt;<br/>&lt;/div&gt;<br/><br/>&lt;div id=&quot;p2&quot; class=&quot;card&quot; style=&quot;display:none&quot;&gt;<br/>&lt;h3&gt;Student QR Scan Karein&lt;/h3&gt;&lt;div id=&quot;reader&quot;&gt;&lt;/div&gt;<br/>&lt;button class=&quot;btn&quot; onclick=&quot;startScan()&quot;&gt;📷 Camera On Karein&lt;/button&gt;<br/>&lt;p style=&quot;text-align:center&quot;&gt;Ya Roll No likhein&lt;/p&gt;<br/>&lt;input id=&quot;manualRoll&quot; placeholder=&quot;Roll No likhein&quot;&gt;<br/>&lt;button class=&quot;btn btn-blue&quot; onclick=&quot;markByRoll()&quot;&gt;Present Karein&lt;/button&gt;<br/>&lt;h3 id=&quot;scanMsg&quot;&gt;&lt;/h3&gt;&lt;h3&gt;Aj ki Attendance: &lt;span id=&quot;todayCount&quot;&gt;0&lt;/span&gt; / &lt;span id=&quot;totalCount&quot;&gt;0&lt;/span&gt;&lt;/h3&gt;&lt;div id=&quot;todayList&quot;&gt;&lt;/div&gt;<br/>&lt;/div&gt;<br/><br/>&lt;div id=&quot;p3&quot; class=&quot;card&quot; style=&quot;display:none&quot;&gt;<br/>&lt;h3&gt;All Students&lt;/h3&gt;&lt;input id=&quot;search&quot; placeholder=&quot;Name / Roll search...&quot; oninput=&quot;renderAll()&quot;&gt;&lt;div id=&quot;allList&quot;&gt;&lt;/div&gt;<br/>&lt;button class=&quot;btn btn-red&quot; onclick=&quot;resetDay()&quot;&gt;🔄 Naya Din - Attendance Reset&lt;/button&gt;<br/>&lt;/div&gt;<br/><br/>&lt;div id=&quot;p4&quot; class=&quot;card&quot; style=&quot;display:none&quot;&gt;&lt;h3&gt;Absent - WhatsApp&lt;/h3&gt;&lt;div id=&quot;absentList&quot;&gt;&lt;/div&gt;&lt;button class=&quot;btn btn-orange&quot; onclick=&quot;sendAllWhatsApp()&quot;&gt;📲 Sab ko WhatsApp Kholo&lt;/button&gt;&lt;/div&gt;<br/><br/>&lt;div id=&quot;p5&quot; class=&quot;card&quot; style=&quot;display:none&quot;&gt;<br/>&lt;h3&gt;📊 Monthly Report - &lt;span id=&quot;monthName&quot;&gt;&lt;/span&gt;&lt;/h3&gt;<br/>&lt;input type=&quot;month&quot; id=&quot;reportMonth&quot; onchange=&quot;renderReport()&quot;&gt;&lt;div id=&quot;reportBox&quot;&gt;&lt;/div&gt;<br/>&lt;button class=&quot;btn btn-dark&quot; onclick=&quot;window.print()&quot;&gt;🖨️ Report Print&lt;/button&gt;<br/>&lt;button class=&quot;btn btn-blue&quot; onclick=&quot;downloadCSV()&quot;&gt;⬇️ Excel Download&lt;/button&gt;<br/>&lt;/div&gt;<br/><br/>&lt;script&gt;<br/>let students = JSON.parse(localStorage.getItem(&#39;ips_students&#39;)||&#39;[]&#39;);<br/>let todayKey=&#39;ips_att_&#39;+new Date().toDateString();<br/>let attendance = JSON.parse(localStorage.getItem(todayKey)||&#39;[]&#39;);<br/>let tempPhoto=&#39;&#39;;<br/>document.getElementById(&#39;sPhoto&#39;).addEventListener(&#39;change&#39;,e=&gt;{let r=new FileReader(); r.onload=()=&gt;tempPhoto=r.result; r.readAsDataURL(e.target.files[0]);});<br/>document.getElementById(&#39;reportMonth&#39;).value=new Date().toISOString().slice(0,7);<br/>document.getElementById(&#39;monthName&#39;).innerText=new Date().toLocaleString(&#39;en&#39;,{month:&#39;long&#39;,year:&#39;numeric&#39;});<br/>function show(n){ [1,2,3,4,5].forEach(i=&gt;{document.getElementById(&#39;p&#39;+i).style.display=i==n?&#39;block&#39;:&#39;none&#39;; document.getElementById(&#39;t&#39;+i).classList.toggle(&#39;active&#39;,i==n)}); renderAll(); renderToday(); renderAbsent(); renderReport(); }<br/>function save(){ localStorage.setItem(&#39;ips_students&#39;,JSON.stringify(students)); localStorage.setItem(todayKey,JSON.stringify(attendance)); }<br/>function makeQRCard(st){ return `&lt;div class=&quot;qr-card&quot;&gt;&lt;img class=&quot;logo&quot; src=&quot;logo.jpg&quot;&gt;&lt;div style=&quot;font-weight:bold;color:#0a1a4d&quot;&gt;IQRA PUBLIC HIGH SCHOOL&lt;/div&gt;&lt;div style=&quot;font-size:12px&quot;&gt;YASIR TOWN FSD&lt;/div&gt;&lt;hr&gt;${st.photo?`&lt;img class=&quot;stu&quot; src=&quot;${st.photo}&quot;&gt;`:&#39;&lt;div style=&quot;font-size:50px&quot;&gt;👦&lt;/div&gt;&#39;}&lt;h2&gt;${st.name}&lt;/h2&gt;&lt;p&gt;Class: ${st.cls} | Roll: ${st.roll}&lt;/p&gt;&lt;p&gt;&lt;b&gt;ID: ${st.id}&lt;/b&gt;&lt;/p&gt;&lt;div class=&quot;qrbox&quot; style=&quot;display:flex;justify-content:center;margin:8px&quot;&gt;&lt;/div&gt;&lt;p style=&quot;font-size:12px&quot;&gt;Scan karke Attendance lagayein&lt;/p&gt;&lt;/div&gt;`; }<br/>function addStudent(){ let name=document.getElementById(&#39;sName&#39;).value.trim(), cls=document.getElementById(&#39;sClass&#39;).value.trim(), roll=document.getElementById(&#39;sRoll&#39;).value.trim(), phone=document.getElementById(&#39;sPhone&#39;).value.trim(); if(!name||!roll) return alert(&#39;Name aur Roll zaroori hai&#39;); let id=&#39;IPS-&#39;+roll; let st={id,name,cls,roll,phone,photo:tempPhoto}; students=students.filter(s=&gt;s.id!==id); students.push(st); save(); document.getElementById(&#39;newCard&#39;).innerHTML=makeQRCard(st)+`&lt;button class=&quot;btn btn-blue&quot; onclick=&quot;window.print()&quot;&gt;🖨️ Print Card&lt;/button&gt;`; new QRCode(document.querySelector(&#39;#newCard .qrbox&#39;),{text:st.id,width:150,height:150}); renderAll(); alert(&#39;Student save ho gaya!&#39;); }<br/><br/>// --- BULK UPLOAD LOGIC ---<br/>function downloadSample(){<br/> let csv=&quot;Name,Class,Roll,Parent Phone\nAli Khan,5th,1,03217066296\nSara Ahmed,5th,2,03211234567\nUsman Ali,6th,3,03001234567&quot;;<br/> let a=document.createElement(&#39;a&#39;); a.href=URL.createObjectURL(new Blob([csv],{type:&#39;text/csv&#39;})); a.download=&#39;IQRA-Sample-Students.csv&#39;; a.click();<br/>}<br/>function addBulkRows(rows){<br/> let added=0;<br/> rows.forEach(r=&gt;{<br/>   let name=(r[0]||&#39;&#39;).toString().trim(), cls=(r[1]||&#39;&#39;).toString().trim(), roll=(r[2]||&#39;&#39;).toString().trim(), phone=(r[3]||&#39;&#39;).toString().trim();<br/>   if(!name||!roll) return;<br/>   if(name.toLowerCase().includes(&#39;name&#39;)) return;<br/>   let id=&#39;IPS-&#39;+roll;<br/>   // agar same roll hai to update karo, naya nahi<br/>   students=students.filter(s=&gt;s.id!==id);<br/>   students.push({id,name,cls,roll,phone,photo:&#39;&#39;});<br/>   added++;<br/> });<br/> save(); renderAll();<br/> document.getElementById(&#39;bulkPreview&#39;).innerHTML=`&lt;b style=&quot;color:green&quot;&gt;✅ ${added} Students Add Ho Gaye! Total ab: ${students.length}&lt;/b&gt;&lt;br&gt;Ab neeche &lt;b&gt;Sare QR Cards Print&lt;/b&gt; dabao aur sab ko card de do. Photo baad me har student ki All Students &gt; QR se add kar sakte ho.`;<br/> alert(added+&#39; Students add ho gaye!&#39;);<br/>}<br/>async function handleBulk(){<br/> let f=document.getElementById(&#39;bulkFile&#39;).files[0];<br/> if(!f) return alert(&#39;Pehle file select karein&#39;);<br/> let name=f.name.toLowerCase();<br/> if(name.endsWith(&#39;.csv&#39;)){<br/>   let txt=await f.text();<br/>   let rows=txt.split(&#39;\n&#39;).map(l=&gt;l.split(&#39;,&#39;).map(x=&gt;x.trim()));<br/>   addBulkRows(rows);<br/> } else if(name.endsWith(&#39;.xlsx&#39;)||name.endsWith(&#39;.xls&#39;)){<br/>   let buf=await f.arrayBuffer();<br/>   let wb=XLSX.read(buf,{type:&#39;array&#39;});<br/>   let ws=wb.Sheets[wb.SheetNames[0]];<br/>   let json=XLSX.utils.sheet_to_json(ws,{header:1});<br/>   addBulkRows(json);<br/> } else if(name.endsWith(&#39;.pdf&#39;)){<br/>   // PDF se text nikalna<br/>   pdfjsLib.GlobalWorkerOptions.workerSrc=&#39;https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js&#39;;<br/>   let buf=await f.arrayBuffer();<br/>   let pdf=await pdfjsLib.getDocument({data:buf}).promise;<br/>   let allText=&#39;&#39;;<br/>   for(let i=1;i&lt;=pdf.numPages;i++){ let page=await pdf.getPage(i); let tc=await page.getTextContent(); allText+=tc.items.map(it=&gt;it.str).join(&#39; &#39;)+&#39;\n&#39;; }<br/>   // PDF lines: Name Class Roll Phone - space ya comma se<br/>   let rows=allText.split(&#39;\n&#39;).map(l=&gt;l.trim().split(/[, ]+/).filter(Boolean));<br/>   // PDF me agar 4 columns hain to ye chalega<br/>   addBulkRows(rows);<br/> } else alert(&#39;Sirf Excel, CSV ya PDF upload karein&#39;);<br/>}<br/>function printAllQRCards(){<br/> if(!students.length) return alert(&#39;Koi student nahi&#39;);<br/> document.getElementById(&#39;allQRCards&#39;).innerHTML=students.map(s=&gt;makeQRCard(s)).join(&#39;&lt;div style=&quot;page-break-after:always&quot;&gt;&lt;/div&gt;&#39;);<br/> // QR generate sab ke liye<br/> document.querySelectorAll(&#39;#allQRCards .qrbox&#39;).forEach((el,i)=&gt;{ new QRCode(el,{text:students[i].id,width:140,height:140}); });<br/> setTimeout(()=&gt;window.print(),800);<br/>}<br/>function markByRoll(){ let r=document.getElementById(&#39;manualRoll&#39;).value.trim(); let st=students.find(s=&gt;s.roll===r||s.id===r||s.id===&#39;IPS-&#39;+r); if(!st) return document.getElementById(&#39;scanMsg&#39;).innerHTML=&#39;❌ Student nahi mila&#39;; markPresent(st); }<br/>function markPresent(st){ let hist=JSON.parse(localStorage.getItem(&#39;ips_history&#39;)||&#39;{}&#39;); let d=new Date().toISOString().slice(0,10); if(!hist[d]) hist[d]=[]; if(!hist[d].includes(st.id)) hist[d].push(st.id); localStorage.setItem(&#39;ips_history&#39;,JSON.stringify(hist)); if(!attendance.includes(st.id)){attendance.push(st.id); save();} document.getElementById(&#39;scanMsg&#39;).innerHTML=&#39;✅ &#39;+st.name+&#39; Present Ho Gaya!&#39;; renderToday(); }<br/>let scanner=null;<br/>function startScan(){ scanner=new Html5Qrcode(&quot;reader&quot;); scanner.start({facingMode:&quot;environment&quot;},{fps:10,qrbox:250},(txt)=&gt;{ let st=students.find(s=&gt;s.id===txt); if(st){markPresent(st); scanner.stop();} else document.getElementById(&#39;scanMsg&#39;).innerHTML=&#39;❌ Is QR ka student nahi mila&#39;; }); }<br/>function renderToday(){ document.getElementById(&#39;todayCount&#39;).innerText=attendance.length; document.getElementById(&#39;totalCount&#39;).innerText=students.length; document.getElementById(&#39;todayList&#39;).innerHTML=students.filter(s=&gt;attendance.includes(s.id)).map(s=&gt;`&lt;div class=&quot;student present card&quot;&gt;&lt;img src=&quot;${s.photo||&#39;&#39;}&quot;&gt;&lt;b&gt;${s.name}&lt;/b&gt; - ${s.cls} | Roll ${s.roll} ✅&lt;/div&gt;`).join(&#39;&#39;)||&#39;Abhi koi present nahi&#39;; }<br/>function renderAll(){ let q=(document.getElementById(&#39;search&#39;).value||&#39;&#39;).toLowerCase(); document.getElementById(&#39;allList&#39;).innerHTML=students.filter(s=&gt;(s.name+s.roll+s.cls).toLowerCase().includes(q)).map(s=&gt;`&lt;div class=&quot;student card ${attendance.includes(s.id)?&#39;present&#39;:&#39;absent&#39;}&quot;&gt;&lt;img src=&quot;${s.photo||&#39;&#39;}&quot;&gt;&lt;div style=&quot;flex:1&quot;&gt;&lt;b&gt;${s.name}&lt;/b&gt;&lt;br&gt;Class ${s.cls} | Roll ${s.roll}&lt;br&gt;${attendance.includes(s.id)?&#39;✅ Present&#39;:&#39;❌ Absent&#39;}&lt;/div&gt;&lt;button onclick=&quot;showQR(&#39;${s.id}&#39;)&quot;&gt;QR&lt;/button&gt;&lt;button onclick=&quot;delStudent(&#39;${s.id}&#39;)&quot;&gt;🗑️&lt;/button&gt;&lt;/div&gt;`).join(&#39;&#39;)||&#39;Koi student nahi&#39;; }<br/>function showQR(id){ let st=students.find(s=&gt;s.id===id); show(1); document.getElementById(&#39;newCard&#39;).innerHTML=makeQRCard(st)+`&lt;button class=&quot;btn btn-blue&quot; onclick=&quot;window.print()&quot;&gt;🖨️ Print&lt;/button&gt;`; new QRCode(document.querySelector(&#39;#newCard .qrbox&#39;),{text:st.id,width:150,height:150}); }<br/>function delStudent(id){ if(confirm(&#39;Delete karein?&#39;)){students=students.filter(s=&gt;s.id!==id); save(); renderAll();} }<br/>function resetDay(){ if(confirm(&#39;Aj ki attendance reset karein?&#39;)){attendance=[]; save(); renderAll(); renderToday(); renderAbsent();} }<br/>function renderAbsent(){ let absent=students.filter(s=&gt;!attendance.includes(s.id)); document.getElementById(&#39;absentList&#39;).innerHTML=absent.map(s=&gt;{ let msg=`Assalam-o-Alaikum, Apka bacha ${s.name} (Class ${s.cls}, Roll ${s.roll}) aj IQRA PUBLIC HIGH SCHOOL, Yasir Town FSD me absent hai.`; let num=s.phone.replace(/[^0-9]/g,&#39;&#39;); if(num.startsWith(&#39;0&#39;)) num=&#39;92&#39;+num.slice(1); return `&lt;div class=&quot;student card&quot;&gt;&lt;img src=&quot;${s.photo||&#39;&#39;}&quot;&gt;&lt;div style=&quot;flex:1&quot;&gt;&lt;b&gt;${s.name}&lt;/b&gt;&lt;br&gt;Parent: ${s.phone}&lt;/div&gt;&lt;a href=&quot;https://wa.me/${num}?text=${encodeURIComponent(msg)}&quot; target=&quot;_blank&quot;&gt;&lt;button style=&quot;padding:10px;background:#25D366;border:0;border-radius:8px;color:#fff;font-weight:bold&quot;&gt;WhatsApp&lt;/button&gt;&lt;/a&gt;&lt;/div&gt;`; }).join(&#39;&#39;)||&#39;Sab present hain! 🎉&#39;; }<br/>function sendAllWhatsApp(){ let absent=students.filter(s=&gt;!attendance.includes(s.id)); absent.forEach((s,i)=&gt;{ setTimeout(()=&gt;{ let msg=`Assalam-o-Alaikum, Apka bacha ${s.name} (Class ${s.cls}, Roll ${s.roll}) aj IQRA PUBLIC HIGH SCHOOL me absent hai.`; let num=s.phone.replace(/[^0-9]/g,&#39;&#39;); if(num.startsWith(&#39;0&#39;)) num=&#39;92&#39;+num.slice(1); window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`,&#39;_blank&#39;); },i*1200); }); }<br/>function renderReport(){ let month=document.getElementById(&#39;reportMonth&#39;).value; let hist=JSON.parse(localStorage.getItem(&#39;ips_history&#39;)||&#39;{}&#39;); let days=Object.keys(hist).filter(d=&gt;d.startsWith(month)).sort(); document.getElementById(&#39;monthName&#39;).innerText=new Date(month+&#39;-01&#39;).toLocaleString(&#39;en&#39;,{month:&#39;long&#39;,year:&#39;numeric&#39;}); let rows=students.map(s=&gt;{ let present=days.filter(d=&gt;hist[d].includes(s.id)).length; let absent=days.length-present; let pct=days.length?Math.round(present/days.length*100):0; return `&lt;tr&gt;&lt;td&gt;&lt;img src=&quot;${s.photo||&#39;&#39;}&quot; style=&quot;width:35px;height:35px;border-radius:50%;object-fit:cover&quot;&gt;&lt;/td&gt;&lt;td&gt;${s.name}&lt;/td&gt;&lt;td&gt;${s.cls}&lt;/td&gt;&lt;td&gt;${s.roll}&lt;/td&gt;&lt;td&gt;${present}&lt;/td&gt;&lt;td&gt;${absent}&lt;/td&gt;&lt;td&gt;${pct}%&lt;/td&gt;&lt;/tr&gt;`; }).join(&#39;&#39;); document.getElementById(&#39;reportBox&#39;).innerHTML=`&lt;p&gt;&lt;b&gt;Total Days:&lt;/b&gt; ${days.length} | &lt;b&gt;Total Students:&lt;/b&gt; ${students.length}&lt;/p&gt;&lt;table&gt;&lt;tr&gt;&lt;th&gt;Photo&lt;/th&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Class&lt;/th&gt;&lt;th&gt;Roll&lt;/th&gt;&lt;th&gt;Present&lt;/th&gt;&lt;th&gt;Absent&lt;/th&gt;&lt;th&gt;%&lt;/th&gt;&lt;/tr&gt;${rows||&#39;&lt;tr&gt;&lt;td colspan=7&gt;Data nahi&lt;/td&gt;&lt;/tr&gt;&#39;}&lt;/table&gt;`; }<br/>function downloadCSV(){ let month=document.getElementById(&#39;reportMonth&#39;).value; let hist=JSON.parse(localStorage.getItem(&#39;ips_history&#39;)||&#39;{}&#39;); let days=Object.keys(hist).filter(d=&gt;d.startsWith(month)); let csv=&quot;Name,Class,Roll,Present,Absent,Percent\n&quot;+students.map(s=&gt;{let p=days.filter(d=&gt;hist[d].includes(s.id)).length; return `${s.name},${s.cls},${s.roll},${p},${days.length-p},${days.length?Math.round(p/days.length*100):0}%`}).join(&quot;\n&quot;); let a=document.createElement(&#39;a&#39;); a.href=URL.createObjectURL(new Blob([csv],{type:&#39;text/csv&#39;})); a.download=&#39;IQRA-Monthly-Report-&#39;+month+&#39;.csv&#39;; a.click(); }<br/>renderAll(); renderToday(); renderAbsent(); renderReport();<br/>&lt;/script&gt;<br/>&lt;/body&gt;<br/>&lt;/html&gt;</body>
